# SecondLook configuration — copy to .env.local, or let `node deploy/deploy.mjs`
# write it for you after a fresh deployment. Nothing here is a secret.

# GenLayer network. Studionet (hosted, gasless): chain 61999.
NEXT_PUBLIC_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_CHAIN_ID=61999
NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio.genlayer.com

# The deployed SecondLookCourt contract. The whole app — pages, panels, agents —
# reads the address from this one variable (fallback constant lives in
# src/lib/config.ts for cases where the env file is absent).
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Used only by the end-to-end live script, not by the app.
FIXTURE_BASE_URL=
